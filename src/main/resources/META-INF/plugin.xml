<idea-plugin>
    <id>com.hackdelft.codegraph</id>
    <name>Codesidian</name>
    <vendor>HackDelft 2026</vendor>
    <description>Interactive file-level graph of your codebase with aggregated method call relationships and AI method explanations.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Codesidian"
                secondary="false"
                anchor="right"
                factoryClass="com.hackdelft.codegraph.CodeGraphToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="com.hackdelft.codegraph.OpenInGraphViewAction"
                class="com.hackdelft.codegraph.OpenInGraphViewAction"
                text="Open in Codesidian"
                description="Reveal the current method or file in the Codesidian map">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="com.hackdelft.codegraph.ExplainWithCodeMapAction"
                class="com.hackdelft.codegraph.ExplainWithCodeMapAction"
                text="Explain with Codesidian"
                description="Generate an AI step-by-step explanation of this method in Codesidian">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
