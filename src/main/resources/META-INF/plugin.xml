<idea-plugin>
    <id>com.hackdelft.codegraph</id>
    <name>Code Graph</name>
    <vendor>HackDelft 2026</vendor>
    <description>Obsidian-like interactive graph of your codebase — files, classes, and method call relationships.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Code Graph"
                secondary="false"
                anchor="right"
                factoryClass="com.hackdelft.codegraph.CodeGraphToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="com.hackdelft.codegraph.OpenInGraphViewAction"
                class="com.hackdelft.codegraph.OpenInGraphViewAction"
                text="Open in Graph View"
                description="Highlight this method in the Code Graph tool window">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="com.hackdelft.codegraph.ExplainWithCodeMapAction"
                class="com.hackdelft.codegraph.ExplainWithCodeMapAction"
                text="Explain with CodeMap"
                description="Generate an AI step-by-step explanation of this method/class in the Code Graph">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
